#!/bin/sh
#
# The height of a block is defined
# by the font size and line spacing.

width() {
    printf '%*s' 4 ":";
}

palette() {
    cb='\033[48;5;%sm%s'
    printf "$cb$cb\n" \
        $1 "$(width)" \
        $2 "$(width)"
}

for i in 0 1 2 3 4 5 6 7; do
    palette "$i" "$((i + 8))"
done

printf '\033[0m\n'
